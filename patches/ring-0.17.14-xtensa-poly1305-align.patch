+// poly1305.c needs 64-byte alignment, so Xtensa uses the stack's 16.
+#[cfg_attr(not(target_arch = "xtensa"), repr(C, align(64)))]
+#[cfg_attr(target_arch = "xtensa", repr(C, align(16)))]
